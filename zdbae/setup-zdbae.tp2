BACKUP ~weidu_external/zdbae/backup~
SUPPORT "https://github.com/dark0dave/BaeBG2/issues"
VERSION ~v0.2.3~
README ~zdbae/readme.md~
// MODDER "setup_tra" "warn" "area_variables" "warn" "missing_extern" "warn" "missing_resref" "warn" "ict2_actions" "warn" "missing_eval" "warn" "overwriting_file" "warn" "fun_args" "warn"
AUTO_EVAL_STRINGS

LANGUAGE ~English~ ~english~ ~zdbae/tra/english/setup.tra~ ~zdbae/tra/english/journal.tra~

// Main Component
BEGIN ~Baeloth BG2~
DESIGNATED 0
LABEL ~zdbae~
REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ ~This mod cannot be installed on this game~
INCLUDE ~zdbae/lib/core.tph~

// Crossmod
// BEGIN ~crossmod~
// DESIGNATED 1
// LABEL ~crossmod~
// REQUIRE_COMPONENT ~zdbae.tp2~ "0" ~Requires main component~
// INCLUDE ~zdbae/lib/crossmod.tph~

// The Real House Wives Of Athkatla (ALPHA)
// BEGIN ~The Real House Wives Of Athkatla~
// DESIGNATED 2
// LABEL ~housewives~
// REQUIRE_COMPONENT ~zdbae.tp2~ "0" ~Requires main component~
// INCLUDE ~zdbae/lib/housewives.tph~

// Baeloth Alt Portrait
BEGIN ~altportrait~
DESIGNATED 10
LABEL ~altportrait~
REQUIRE_COMPONENT ~zdbae.tp2~ "0" ~Requires main component~
INCLUDE ~zdbae/lib/altportrait.tph~
