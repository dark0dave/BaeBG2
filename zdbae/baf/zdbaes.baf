IF
    InParty(Myself)
    !Global("ZDBAE_LEFT", "GLOBAL", 1)
    Global("ZDBAE_HOSTILE", "GLOBAL", 1)
    Global("ZDBAE_JOINED", "GLOBAL", 2)
THEN
    RESPONSE #100
        SetGlobal("ZDBAE_HOSTILE", "GLOBAL", 1)
        Enemy()
        Continue()
END

// First Time Join
IF
    !InParty(Myself)
    Global("ZDBAE_JOINED", "GLOBAL", 1)
    Global("ZDBAEJOINFIRST", "GLOBAL", 0)
THEN
    RESPONSE #100
        SetGlobal("ZDBAEJOINFIRST", "GLOBAL", 1)
        SetGlobal("ZDBAEJOINXP", "GLOBAL", 1)
        JoinParty()
END

// Experience
IF
    Global("ZDBAEJOINXP", "GLOBAL", 1)
    InParty(Myself)
    XPGT(Player1, 1249999)
    XPLT(Myself, 1250000)
THEN
    RESPONSE #100
        SetInterrupt(FALSE)
        SetGlobal("ZDBAEJOINXP", "GLOBAL", 2)
        ChangeStat(Myself, XP, 1250000, SET)
        SetInterrupt(TRUE)
END

