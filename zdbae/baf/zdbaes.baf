// --------------------------------------
// The Real House Wives of Athkatla Quest
// --------------------------------------
IF
    InParty("ZDBAE")
    Global("ZDCreateBootTimer", "GLOBAL", 0)
THEN
    RESPONSE #100
        SetGlobal("ZDCreateBootTimer", "GLOBAL", 1)
        SetGlobalTimer("ZDBootTimer", "GLOBAL", 3600)
END

// Trigger Destroy Boots
IF
    GlobalTimerExpired("ZDBootTimer", "GLOBAL")
    AreaType(CITY)
    Global("ZDBaeBoots", "GLOBAL", 0)
THEN
    RESPONSE #100
        SetGlobal("ZDBaeBoots", "GLOBAL", 1)
        ActionOverride("ZDBAE", DestroyItem("BOOT06"))
        StartDialogNoSet(Player1)
END

// Trigger
IF
    InParty(Myself)
    See(Player1)
    !StateCheck(Player1, CD_STATE_NOTVALID)
    !StateCheck(Myself, CD_STATE_NOTVALID)
    CombatCounter(0)
    AreaCheck("AR0700")
    Global("ZDBaeBootTrigger", "GLOBAL", 1)
    Global("ZDBaeBoots", "GLOBAL", 1)
THEN
    RESPONSE #100
        MoveToObject(Player1)
        StartDialogNoSet(Player1)
END

// Boots
/* baeloth has da boots with da fur */
IF
    HasItem("zdbo01", Myself)
    Global("ZDAuctionTrigger", "GLOBAL", 3)
    Global("zdbaefurries", "GLOBAL", 0)
THEN
    RESPONSE #100
        SetGlobal("zdbaefurries", "GLOBAL", 1)
        StartDialogNoSet([PC])
END

/* baeloth has the luxurious lizardskin leapers */
IF
    HasItem("zdbo02", Myself)
    Global("ZDAuctionTrigger", "GLOBAL", 3)
    Global("zdbaeleapers", "GLOBAL", 0)
THEN
    RESPONSE #100
        SetGlobal("zdbaeleapers", "GLOBAL", 1)
        StartDialogNoSet([PC])
END

/* sturdy boots are equipped */
IF
    HasItem("zdbo02", Myself)
    Global("ZDAuctionTrigger", "GLOBAL", 3)
    Global("zdbaesturdy", "GLOBAL", 0)
THEN
    RESPONSE #100
        SetGlobal("zdbaesturdy", "GLOBAL", 1)
        StartDialogNoSet([PC])
END

/* baeloth has the simple boots - how DARE you! */
IF
    HasItem("boot06", Myself)
    Global("ZDAuctionTrigger", "GLOBAL", 3)
    Global("zdbaesimple", "GLOBAL", 0)
THEN
    RESPONSE #100
        SetGlobal("zdbaesimple", "GLOBAL", 1)
        StartDialogNoSet([PC])
END

// --------------------------------------
// Friendship
// --------------------------------------
IF
    InParty(Myself)
    Global("ZDBaeFriendshipActive", "GLOBAL", 0)
THEN
    RESPONSE #100
        RealSetGlobalTimer("ZDBaeFriendshipTalksTimer", "GLOBAL", 1200)
        SetGlobal("ZDBaeFriendshipTalks", "GLOBAL", 1)
        SetGlobal("ZDBaeFriendshipActive", "GLOBAL", 1)
END

IF
    InParty(Myself)
    See(Player1)
    RealGlobalTimerExpired("ZDBaeFriendshipTalksTimer", "GLOBAL")
    !StateCheck(Player1, CD_STATE_NOTVALID)
    !StateCheck(Myself, CD_STATE_NOTVALID)
    CombatCounter(0)
    !See([ENEMY])
    Global("ZDBaeFriendshipActive", "GLOBAL", 1)
    OR(4)
        Global("ZDBaeFriendshipTalks", "GLOBAL", 1)
    // Global("ZDBaeFriendshipTalks","GLOBAL",3)
THEN
    RESPONSE #100
        IncrementGlobal("ZDBaeFriendshipTalks", "GLOBAL", 1)
END

IF
    InParty(Myself)
    See(Player1)
    !StateCheck(Myself, CD_STATE_NOTVALID)
    !StateCheck(Player1, CD_STATE_NOTVALID)
    Global("ZDBaeFriendshipActive", "GLOBAL", 1)
    CombatCounter(0)
    !See([ENEMY])
    OR(4)
        Global("ZDBaeFriendshipTalks", "GLOBAL", 2)
    // Global("ZDBaeFriendshipTalks","GLOBAL",4)
THEN
    RESPONSE #100
        MoveToObject(Player1)
        Dialogue(Player1)
END
